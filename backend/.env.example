# ============================================================
# Environment Variables Example (.env.example)
# ============================================================

# --- Groq LLM API ---
# Get token from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# --- Monday.com API ---
# Get token from: Monday.com → Profile Avatar → Administration/Developers → API
MONDAY_API_TOKEN=your_monday_api_token_here

# Board IDs from Monday.com URLs (e.g. 1234567890)
MONDAY_WO_BOARD_ID=your_work_orders_board_id_here
MONDAY_DEALS_BOARD_ID=your_deals_board_id_here
