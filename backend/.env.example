# ============================================================
# Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# --- Google Gemini API ---
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Which Gemini model to use. Change without touching code.
# Options: gemini-2.0-flash, gemini-2.5-flash, gemini-1.5-flash, etc.
GEMINI_MODEL=gemini-2.0-flash

# --- Monday.com API ---
# Get your token from: Monday.com → Profile → Developer → API Token
MONDAY_API_TOKEN=eyJ...

# Board IDs — found in the Monday.com board URL:
# https://your-org.monday.com/boards/<BOARD_ID>
MONDAY_WO_BOARD_ID=
MONDAY_DEALS_BOARD_ID=
